# Copy to .env.local and adjust. Every value has a development default.

# Database. A local SQLite file by default; point at a hosted libsql/Turso
# database in production (libsql://your-db.turso.io) and set the auth token.
DATABASE_URL=file:./data/planner.db
DATABASE_AUTH_TOKEN=

# Public base URL, used to build password-reset links. Required in production
# so links can't be forged through the Host header. On Render the service URL
# (RENDER_EXTERNAL_URL) is used when this is empty.
APP_URL=http://localhost:3000

# Outgoing email for password resets, e.g. smtp://user:pass@smtp.example.com:587
# Without it, reset links are printed to the server console in development only.
SMTP_URL=
MAIL_FROM="All-In Planner <no-reply@example.com>"

# Set to 1 when running behind a reverse proxy that sets X-Forwarded-For,
# so rate limits apply per client IP. (Detected automatically on Vercel.)
TRUST_PROXY=
